{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/Resources/assets/src/**/*.ts", "src/Resources/assets/stimulus-peers/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
