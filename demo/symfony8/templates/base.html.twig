{#
  Demo host layout on the UiKit document layout (assets from the UiKit asset package, theme tokens printed by UiKit):
  masthead + content; the PWA head tags and install prompt come from the bundle.
#}
{% extends '@NowoUiKit/layout/document.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}PWA Demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ nowo_pwa_head() }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('demo/demo.css') }}">
{% endblock %}

{% block nowo_ui_body %}
    <header class="demo-masthead">
        <a class="demo-masthead__brand" href="{{ path('app_home') }}">PWA Bundle <span>demo</span></a>
        <nav class="demo-masthead__nav" aria-label="Demo">
            <a href="{{ path('app_home') }}"{% if app.request.attributes.get('_route') == 'app_home' %} aria-current="page"{% endif %}>Install</a>
            <a href="{{ path('nowo_pwa_offline') }}">Offline page</a>
            <a href="{{ path('nowo_pwa_manifest') }}">Manifest</a>
            <a href="{{ path('nowo_pwa_service_worker') }}">Service worker</a>
        </nav>
    </header>
    <main class="demo-main" id="content">
        {% block body %}{% endblock %}
    </main>
    {{ nowo_pwa_install_prompt() }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('demo/demo.js') }}" defer></script>
{% endblock %}
