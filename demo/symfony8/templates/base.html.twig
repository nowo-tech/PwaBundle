{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo; the PWA head
    tags and the install prompt come from the bundle. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'PWA',
    home_route: 'app_home',
    repository: 'https://github.com/nowo-tech/PwaBundle',
    translation_domain: false,
    nav: [
        {label: 'Install', route: 'app_home', section: 'Demo'},
        {label: 'Offline page', route: 'nowo_pwa_offline', section: 'Bundle endpoints', active: []},
        {label: 'Manifest', route: 'nowo_pwa_manifest', section: 'Bundle endpoints', active: []},
        {label: 'Service worker', route: 'nowo_pwa_service_worker', section: 'Bundle endpoints', active: []},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}PWA Demo{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {{ nowo_pwa_head() }}
{% endblock %}

{% block nowo_ui_modals %}
    {{ nowo_pwa_install_prompt() }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    <script src="{{ asset('demo/demo.js') }}" defer></script>
{% endblock %}
