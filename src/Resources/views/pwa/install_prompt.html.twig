{# Install prompt — dismissible (remind later / never ask again) #}
{% set display = install_prompt.display|default('banner') %}
{% set css_class = install_prompt.css_class|default('nowo-pwa-install') %}
{% set mark_asset = install_prompt.mark_asset|default(null) %}
{% set install_title = install_prompt.title is defined and install_prompt.title is not same as(null) and install_prompt.title is not same as('')
    ? install_prompt.title|trans
    : 'install.action'|trans({}, 'NowoPwaBundle') %}
{% set install_eyebrow = install_prompt.eyebrow is defined and install_prompt.eyebrow is not same as(null) and install_prompt.eyebrow is not same as('')
    ? install_prompt.eyebrow|trans
    : null %}
{% set install_button_class = install_prompt.button_class|default('') %}
{% if install_button_class is same as('') %}
    {% set install_button_class = css_class ~ '__button ' ~ css_class ~ '__button--install' %}
{% endif %}
{% set dismiss_button_class = install_prompt.dismiss_button_class is defined ? install_prompt.dismiss_button_class : null %}
{% if dismiss_button_class is same as(null) %}
    {% set dismiss_button_class = css_class ~ '__button ' ~ css_class ~ '__button--dismiss' %}
{% endif %}
{% set never_button_class = install_prompt.never_button_class is defined ? install_prompt.never_button_class : null %}
{% if never_button_class is same as(null) %}
    {% set never_button_class = css_class ~ '__button ' ~ css_class ~ '__button--never' %}
{% endif %}
<div id="nowo-pwa-install"
     class="{{ css_class }} {{ css_class }}--{{ display }} {{ css_class }}--{{ install_prompt.position|default('bottom') }}"
     hidden
     role="dialog"
     aria-labelledby="nowo-pwa-install-title"
     aria-modal="{{ display == 'modal' ? 'true' : 'false' }}"
     data-display="{{ display }}"
     data-dismiss-key="{{ install_prompt.dismiss_key|default('nowo_pwa_install_dismissed') }}"
     data-dismiss-days="{{ install_prompt.dismiss_days|default(7) }}"
     data-never-dismiss-key="{{ install_prompt.never_dismiss_key|default('nowo_pwa_install_never') }}"
     data-show-never-option="{{ install_prompt.show_never_option|default(true) ? '1' : '0' }}"
     data-delay-ms="{{ install_prompt.delay_ms|default(0) }}"
     data-visibility="{{ install_prompt.visibility|default('all') }}">
    {% if display == 'modal' %}
        <div class="{{ css_class }}__backdrop" data-pwa-install-action="dismiss-remind" aria-hidden="true"></div>
    {% endif %}
    <div class="{{ css_class }}__panel">
        {% block pwa_install_mark %}
            {% if mark_asset %}
                <div class="{{ css_class }}__brand">
                    <img src="{{ mark_asset }}" alt="{{ manifest.short_name|default(manifest.name|default('App')) }}" class="{{ css_class }}__mark">
                </div>
            {% endif %}
        {% endblock %}

        {% block pwa_install_eyebrow %}
            {% if install_eyebrow %}
                <p class="{{ css_class }}__eyebrow">{{ install_eyebrow }}</p>
            {% endif %}
        {% endblock %}

        {% block pwa_install_title %}
            <h2 id="nowo-pwa-install-title" class="{{ css_class }}__title">{{ install_title }}</h2>
        {% endblock %}

        <p id="nowo-pwa-install-message" class="{{ css_class }}__message">{{ 'install.message'|trans({}, 'NowoPwaBundle') }}</p>

        {% block pwa_install_actions %}
            <div class="{{ css_class }}__actions">
                <button type="button" class="{{ install_button_class }}" data-pwa-install-action="install">{{ 'install.action'|trans({}, 'NowoPwaBundle') }}</button>
                <button type="button" class="{{ dismiss_button_class }}" data-pwa-install-action="dismiss-remind">{{ 'install.dismiss_remind'|trans({}, 'NowoPwaBundle') }}</button>
                {% if install_prompt.show_never_option|default(true) %}
                    <button type="button" class="{{ never_button_class }}" data-pwa-install-action="dismiss-never">{{ 'install.dismiss_never'|trans({}, 'NowoPwaBundle') }}</button>
                {% endif %}
            </div>
        {% endblock %}
    </div>
</div>
