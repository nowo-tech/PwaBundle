{#
  Offline fallback page (REQ-UI-003, unique page — see docs/TEMPLATES.md): extends the layout of the page model, by
  default the self-contained UiKit status layout (@NowoUiKit/layout/status.html.twig: inline critical CSS with the
  CSP nonce, theme tokens, no stylesheet / script request, no session flashes), so the service worker can serve it
  from its cache without network. The panel reuses the page/auth regions and theme slots (auth_panel, card_body,
  page_title, page_intro, auth_footer, auth_links) without the auth scaffold, which needs symfony/form.

  Variables: page (Nowo\UiKitBundle\View\AuthPage built by Nowo\PwaBundle\View\OfflinePage: title, intro, brand =
  manifest name, links = "Try again" → start_url, layout = nowo_pwa.web_ui.layout_template ?? status layout,
  scripts: false); 1.x variables manifest_name, manifest, retry_url.
  Override one block with nowo_pwa.web_ui.templates.offline pointing to a template that
  {% extends '@!NowoPwaBundle/pwa/offline.html.twig' %}: pwa_offline_head (meta tags in <head>), pwa_offline_brand,
  pwa_offline_content (heading + message), pwa_offline_actions (the retry link).
#}
{% extends page.layout ?? nowo_ui_layout.guest %}
{% set nowo_ui_bundle = page.bundle %}
{% set nowo_ui_page_type = 'auth' %}
{% set nowo_ui_scripts_enabled = page.scripts %}

{% block nowo_ui_document_title %}{{ 'offline.title'|trans({}, 'NowoPwaBundle') }}{% if page.brand %} — {{ page.brand|nowo_ui_trans }}{% endif %}{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    {% block pwa_offline_head %}
        {% if manifest.theme_color|default(null) %}<meta name="theme-color" content="{{ manifest.theme_color }}">{% endif %}
    {% endblock %}
{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('auth_panel', _b) }} nowo-pwa-offline" data-nowo-ui-page="auth" data-nowo-ui-region="panel"{{ nowo_ui_attrs('auth_panel', _b) }}{{ nowo_ui_html_attrs(page.attributes) }}>
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {% block pwa_offline_brand %}
                {% if page.brand %}<p class="nowo-ui-auth-panel__brand nowo-pwa-offline__brand">{{ page.brand|nowo_ui_trans }}</p>{% endif %}
            {% endblock %}
            {% block pwa_offline_content %}
                <h1 class="{{ nowo_ui_class('page_title', _b) }}">{{ page.title|nowo_ui_trans }}</h1>
                {% if page.intro %}<p class="{{ nowo_ui_class('page_intro', _b) }}">{{ page.intro|nowo_ui_trans }}</p>{% endif %}
            {% endblock %}
        </div>
        {% set _actions %}
            {% block pwa_offline_actions %}
                {% if page.links is not empty %}
                    <ul class="{{ nowo_ui_class('auth_links', _b) }}">
                        {% for link in page.links %}
                            <li><a href="{{ link.href }}"{{ nowo_ui_html_attrs(link.attributes) }}>{{ link.label|nowo_ui_trans }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endblock %}
        {% endset %}
        {% if _actions|trim is not empty %}
            <footer class="{{ nowo_ui_class('auth_footer', _b) }}">{{ _actions }}</footer>
        {% endif %}
    </section>
{% endblock %}
