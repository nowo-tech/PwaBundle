<!DOCTYPE html>
<html lang="{{ manifest.lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'offline.title'|trans({}, 'NowoPwaBundle') }} — {{ manifest_name }}</title>
    <style>
        :root {
            --nowo-pwa-offline-bg: #0f172a;
            --nowo-pwa-offline-color: #f8fafc;
            --nowo-pwa-offline-link-color: #38bdf8;
            --nowo-pwa-offline-brand-color: #cbd5e1;
            --nowo-pwa-offline-panel-width: 28rem;
            --nowo-pwa-offline-gap: 0.75rem;
            --nowo-pwa-offline-padding: 2rem;
        }
        body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--nowo-pwa-offline-bg); color: var(--nowo-pwa-offline-color); text-align: center; padding: var(--nowo-pwa-offline-padding); }
        .nowo-pwa-offline { display: grid; gap: var(--nowo-pwa-offline-gap); }
        .nowo-pwa-offline__brand { font-size: 0.875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nowo-pwa-offline-brand-color); }
        .nowo-pwa-offline__content { display: grid; gap: var(--nowo-pwa-offline-gap); }
        h1 { font-size: 1.5rem; margin: 0; }
        p { opacity: .85; max-width: var(--nowo-pwa-offline-panel-width); margin: 0; }
        a { color: var(--nowo-pwa-offline-link-color); }
    </style>
</head>
<body>
    <div class="nowo-pwa-offline">
        {% block pwa_offline_brand %}
            <div class="nowo-pwa-offline__brand">{{ manifest_name }}</div>
        {% endblock %}

        {% block pwa_offline_content %}
            <div class="nowo-pwa-offline__content">
                <h1>{{ 'offline.heading'|trans({}, 'NowoPwaBundle') }}</h1>
                <p>{{ 'offline.body'|trans({}, 'NowoPwaBundle') }}</p>
                <p><a href="{{ retry_url|default('/') }}">{{ 'offline.retry'|trans({}, 'NowoPwaBundle') }}</a></p>
            </div>
        {% endblock %}
    </div>
</body>
</html>
