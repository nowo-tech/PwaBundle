<!DOCTYPE html>
<html lang="{{ manifest.lang|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'offline.title'|trans({}, 'NowoPwaBundle') }} — {{ manifest_name }}</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0f172a; color: #f8fafc; text-align: center; padding: 2rem; }
        h1 { font-size: 1.5rem; margin-bottom: .5rem; }
        p { opacity: .85; max-width: 28rem; }
        a { color: #38bdf8; }
    </style>
</head>
<body>
    <div>
        <h1>{{ 'offline.heading'|trans({}, 'NowoPwaBundle') }}</h1>
        <p>{{ 'offline.body'|trans({}, 'NowoPwaBundle') }}</p>
        <p><a href="/">{{ 'offline.retry'|trans({}, 'NowoPwaBundle') }}</a></p>
    </div>
</body>
</html>
