<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\PwaBundle\Tests\Integration\Ddd\Domain\StoredPushSubscription" table="host_push_subscription">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="recipientId" column="recipient_id" type="string" length="180"/>
        <field name="endpoint" type="string" length="500"/>
        <field name="p256dh" type="string" length="255"/>
        <field name="authToken" column="auth_token" type="string" length="255"/>
        <indexes>
            <index name="idx_host_push_recipient" columns="recipient_id"/>
        </indexes>
    </entity>
</doctrine-mapping>
